{
  "schema_version": 1,
  "repository": {
    "id": "local.media-pipeline-assistant.repo",
    "name": "Media Pipeline Assistant"
  },
  "plugins": [
    {
      "id": "local.media-pipeline-assistant",
      "name": "Media Pipeline Assistant",
      "version": "0.1.2",
      "description": "唯讀使用 DIAN115 live-proven status=failed&page=1&page_size=20 取得 bounded history，再於 WASM 篩選 rule_id=2，建立 Smart Rescue 安全候選讀取基線。",
      "author": "Local Publisher",
      "package_url": "local.media-pipeline-assistant-0.1.2.d115p",
      "sha256": "59066c97e8084868cbb22cc8c7d71d9f64f12f1fe3ef658247f895137f70dd5c",
      "runtime": {
        "kind": "wasm",
        "protocol": "dian115:wasm@1",
        "autostart": true,
        "trust_level": "wasm-sandbox"
      },
      "permissions": {
        "apis": [
          {
            "method": "GET",
            "path": "/api/organize/history",
            "reason": "讀取整理歷史並找出失敗案例"
          },
          {
            "method": "GET",
            "path": "/api/organize/history/:id/detail",
            "reason": "讀取單筆整理失敗的詳細資訊"
          },
          {
            "method": "GET",
            "path": "/api/organize/history/:id/manual-organize-context",
            "reason": "讀取單筆失敗項目的手動整理上下文"
          },
          {
            "method": "GET",
            "path": "/api/organize/queue",
            "reason": "讀取目前待整理佇列"
          },
          {
            "method": "GET",
            "path": "/api/organize/rules",
            "reason": "讀取整理規則以理解失敗項目的來源規則"
          }
        ]
      },
      "tags": [
        "organize",
        "diagnostics",
        "read-only"
      ]
    }
  ]
}
