{
  "schema_version": 1,
  "repository": {
    "id": "local.media-pipeline-assistant.repo",
    "name": "Media Pipeline Assistant"
  },
  "plugins": [
    {
      "id": "local.media-pipeline-assistant",
      "name": "Media Pipeline Assistant",
      "version": "0.1.1",
      "description": "唯讀分析 DIAN115 整理歷史，在 WASM runtime 解析完整回應、統計 status 與 rule_id=2，並篩出 failed 案例，作為後續 Smart Rescue 自動補救流程的安全基線。",
      "author": "Local Publisher",
      "package_url": "local.media-pipeline-assistant-0.1.1.d115p",
      "sha256": "54785c9c09677b962e6dabbdf25ca1428a405b181f352cb3dc5225010f18a535",
      "runtime": {
        "kind": "wasm",
        "protocol": "dian115:wasm@1",
        "autostart": true,
        "trust_level": "wasm-sandbox"
      },
      "permissions": {
        "apis": [
          {
            "method": "GET",
            "path": "/api/organize/history",
            "reason": "讀取整理歷史並找出失敗案例"
          },
          {
            "method": "GET",
            "path": "/api/organize/history/:id/detail",
            "reason": "讀取單筆整理失敗的詳細資訊"
          },
          {
            "method": "GET",
            "path": "/api/organize/history/:id/manual-organize-context",
            "reason": "讀取單筆失敗項目的手動整理上下文"
          },
          {
            "method": "GET",
            "path": "/api/organize/queue",
            "reason": "讀取目前待整理佇列"
          },
          {
            "method": "GET",
            "path": "/api/organize/rules",
            "reason": "讀取整理規則以理解失敗項目的來源規則"
          }
        ]
      },
      "tags": [
        "organize",
        "diagnostics",
        "read-only"
      ]
    }
  ]
}
