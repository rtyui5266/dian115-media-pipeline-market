{
  "schema_version": 1,
  "repository": {
    "id": "local.media-pipeline-assistant.repo",
    "name": "Media Pipeline Assistant"
  },
  "plugins": [
    {
      "id": "local.media-pipeline-assistant",
      "name": "Media Pipeline Assistant",
      "version": "0.1.4",
      "description": "透過 localhost read-only bridge 快速讀取 Rule 2 failed，分類失敗原因；對明確 gRPC/CD2 timeout（context deadline exceeded / rpc DeadlineExceeded） 僅使用 DIAN native 單筆 history DELETE 解除 suppression。",
      "author": "Local Publisher",
      "package_url": "local.media-pipeline-assistant-0.1.4.d115p",
      "sha256": "c43cc872df72f87caa1543839e3e1d620b99f308cdecf2357279d4b8b48bc67b",
      "runtime": {
        "kind": "wasm",
        "protocol": "dian115:wasm@1",
        "autostart": true,
        "trust_level": "wasm-sandbox"
      },
      "permissions": {
        "apis": [
          {
            "method": "GET",
            "path": "/api/organize/history/:id/detail",
            "reason": "讀取單筆整理失敗的詳細資訊"
          },
          {
            "method": "GET",
            "path": "/api/organize/history/:id/manual-organize-context",
            "reason": "讀取單筆失敗項目的手動整理上下文"
          },
          {
            "method": "GET",
            "path": "/api/organize/queue",
            "reason": "讀取目前待整理佇列"
          },
          {
            "method": "GET",
            "path": "/api/organize/rules",
            "reason": "讀取整理規則以理解失敗項目的來源規則"
          },
          {
            "method": "DELETE",
            "path": "/api/organize/history/:id",
            "reason": "對明確 gRPC/CD2 context deadline exceeded 的單筆 failed history 解除 suppression，讓 DIAN115 自動重新處理"
          }
        ],
        "network": [
          {
            "origin": "http://127.0.0.1:11541",
            "methods": [
              "GET"
            ],
            "proxy_mode": "direct",
            "reason": "從本機 read-only Rule 2 bridge 取得 bounded failed candidates，避開 DIAN history aggregation 超時"
          }
        ]
      },
      "tags": [
        "organize",
        "smart-rescue",
        "controlled-write"
      ]
    }
  ]
}
